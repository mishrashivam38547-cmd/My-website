rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{fileName} {
      allow read: if true; // Portfolio previews are public. Use authenticated-only reads for private files.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)|video/(mp4|webm)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}