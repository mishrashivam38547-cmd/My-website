rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Create /admins/{YOUR_ADMIN_UID} in Firestore using the Firebase Console.
    // This document must be created by a trusted project owner, never by public clients.
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /users/{uid} {
      allow read: if resource.data.published == true || (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName','role','skills','city','whatsapp','website','bio','published','updatedAt','createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 70
        && request.resource.data.role in ['Artist','Graphic Designer','Architect','Developer']
        && request.resource.data.published == true;
      allow update: if (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','role','skills','city','whatsapp','website','bio','published','updatedAt','createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 70
        && request.resource.data.role in ['Artist','Graphic Designer','Architect','Developer'])
        || isAdmin();
      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();

      match /projects/{projectId} {
        allow read: if get(/databases/$(database)/documents/users/$(uid)).data.published == true
          && resource.data.published == true
          || (signedIn() && request.auth.uid == uid) || isAdmin();
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['title','type','price','description','link','mediaUrl','storagePath','published','createdAt'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 100
          && request.resource.data.type in ['service','design','video','digital','project']
          && request.resource.data.price is number && request.resource.data.price >= 0
          && request.resource.data.published == true;
        allow update, delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
      }
    }
  }
}